# Sitio público usado por Mercado Pago para back_urls y webhooks.
NEXT_PUBLIC_BASE_URL=https://fcia-oasis.vercel.app

# Supabase: necesario para guardar órdenes, productos reales y stock.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mercado Pago Checkout Pro.
# El public key puede estar en el browser; el access token es secreto y debe cargarse solo en Vercel/local .env.local.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-b21e59d6-6943-4f0f-a29f-d943429fee03
MERCADOPAGO_ACCESS_TOKEN=

# Correo Argentino MiCorreo.
# API_URL es opcional; usar apitest para pruebas si Correo Argentino lo habilita en tu cuenta.
CORREO_ARGENTINO_API_URL=https://apitest.correoargentino.com.ar/micorreo/v1
CORREO_ARGENTINO_USER=
CORREO_ARGENTINO_PASSWORD=
CORREO_ARGENTINO_CUSTOMER_ID=
CORREO_ARGENTINO_ORIGIN_POSTAL_CODE=

# Emails de pedidos (Resend).
RESEND_API_KEY=
EMAIL_FROM=Farmacia Oasis <ventas@tudominio.com>
ORDER_NOTIFICATION_EMAIL=farmaciaoasis13@gmail.com
